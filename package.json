{
  "name": "smart-campus-visual-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Visual companion dashboard for the Smart Campus Bus Tracker C++ console project.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm run typecheck:functions",
    "typecheck:functions": "tsc --noEmit --target es2022 --module esnext --moduleResolution bundler --skipLibCheck --strict netlify/functions/*.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.185.1",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^4.1.10"
  }
}
